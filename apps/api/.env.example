# Postr API — environment variables
#
# Copy to `.env` and fill in values. None of these are exposed to the
# browser; keep the secret keys out of source control.

# Port the Express server listens on. Render sets this automatically
# in prod; only override in dev.
PORT=8787

# Comma-separated list of allowed origins for CORS. Must include the
# dev origin AND every production origin you serve the frontend from.
# Example:
#   dev:  http://localhost:5173
#   prod: https://postr.sh,https://www.postr.sh
# No trailing slashes, no spaces.
CORS_ORIGINS=http://localhost:5173

# ── Supabase (server-side) ────────────────────────────────────────
# Project URL — same as VITE_SUPABASE_URL on the web app.
SUPABASE_URL=

# Service / secret key — NEVER expose this to the browser. Used by
# the API for admin operations (create-user, send-email, etc.). Store
# as an encrypted env var in Render.
SUPABASE_SECRET_KEY=

# ── LLM providers ─────────────────────────────────────────────────
# Anthropic API key. Used by the vision endpoints: poster import
# (/api/import/extract), style extraction, and Presentation Checker.
# Provider work is rate-limited per user by the middleware stack.
ANTHROPIC_API_KEY=

# OpenAI API key. Used by the manuscript condenser
# (apps/api/src/narrative/) — the model id lives in narrative/config.ts,
# currently gpt-5.6-terra. Without this key /paper-to-poster ingests and
# maps fine, then fails at the condense step.
OPENAI_API_KEY=

# ── Cron endpoints ────────────────────────────────────────────────
# Shared secret used by scheduled jobs (e.g. anonymous user cleanup).
# Generate a random 32-byte hex string: `openssl rand -hex 32`.
# GitHub Actions calls these endpoints with `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# ── Stripe (Managed Payments) ─────────────────────────────────────
# Powers the term, export pack, review pack, and weekly review add-on
# (apps/api/src/billing.ts). Real values come from the Stripe Dashboard
# — use SANDBOX keys/prices for testing and LIVE ones in production.
# NEVER commit real keys; store them as encrypted env vars in Render.

# Stripe secret key. Sandbox for testing (sk_test_...), live for prod
# (sk_live_...). From Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. From the Dashboard webhook endpoint config
# (Developers → Webhooks → your endpoint → Signing secret). If this is
# MISSING the webhook fails closed (returns 500), so payments won't be
# fulfilled until it's set.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price id for the $18.99 term product.
STRIPE_PRICE_TERM=price_...

# Stripe Price id for the $9.99 3-export pack product.
STRIPE_PRICE_PACK=price_...

# Stripe Price id for the one-time Presentation Checker review pack.
# The final live amount/credit count is set only after the frozen-corpus
# cost gate and production dogfood have been signed off.
STRIPE_PRICE_REVIEW_PACK=price_...

# Stripe Price id for the recurring weekly-review add-on. This checkout
# is available only to users with an active term.
STRIPE_PRICE_REVIEW_ADDON=price_...

# Keep server-side PPTX conversion disabled until LibreOffice/Poppler run
# in an isolated, secret-free worker and the Render smoke has passed.
REVIEW_PPTX_ENABLED=false

# The app's public origin — used to build the checkout success/cancel
# redirect URLs. Defaults to http://localhost:5173 in dev.
# Example (prod): https://www.postr.sh
APP_ORIGIN=http://localhost:5173
