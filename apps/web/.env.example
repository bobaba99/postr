# Postr web app — environment variables
#
# Copy to `.env` and fill in values. Vite only exposes variables that
# start with `VITE_` to the browser, so every name below is deliberate.
# Never add secrets here — anything you put in a VITE_ var ships to
# every visitor's browser.

# ── Supabase (browser client) ─────────────────────────────────────
# Project URL — e.g. https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key — NOT the service_role / secret key.
# Safe to expose; RLS policies are what actually protect the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Backend API ────────────────────────────────────────────────────
# Base URL of the Express API (apps/api). Dev: http://localhost:8787
# Prod: https://api.postr.sh (or whatever Render hostname you pick).
# No trailing slash.
VITE_API_BASE_URL=

# ── Presentation Checker rollout ──────────────────────────────────
# Keep the editor entry point hidden until the frozen-corpus quality gate,
# live pricing, production dogfood, and indexing checklist are complete.
# The direct /presentation-checker noindex route remains available for
# internal smoke testing.
VITE_ENABLE_PRESENTATION_CHECKER=false

# PPTX is a separate final rollout gate because conversion needs an
# isolated LibreOffice/Poppler worker. Leave false until that deployment
# and its production smoke are recorded.
VITE_ENABLE_REVIEW_PPTX=false
