node_modules
dist
*.tsbuildinfo
.env*
!.env.example
.vercel
.turbo
supabase/.temp
coverage
*.log
.DS_Store
# Playwright MCP session cache — transient, shouldn't be tracked.
.playwright-mcp/
ux-audit/supabase/.env
# Claude Code per-project config / agents / skills — machine-specific.
.claude/
# One-off UX audit screenshots dropped at repo root. Curated captures
# belong in docs/ux-audit/<date>/.
/ux-audit-*.png
/page-*.png
/screenshot-*.png
docs/test_posters/
social_media_content/
# Benchmark output artifacts — scripts/ itself is tracked source.
scripts/poster-benchmark/
# Transient perf traces + bulky captures. Curated captures belong in
# docs/ux-audit/<date>/ (same rule as the root screenshot ignores).
docs/debug/
docs/screenshots/
# Sample .postr archives are multi-MB zips — keep them out of git.
docs/*.postr
# Agent scratch (wave reports, plans) — keep on disk, out of git.
.superpowers/
.scratch/

# Text-audit output (regenerate with scripts/text-audit/scrape.mts)
docs/text-audit/
